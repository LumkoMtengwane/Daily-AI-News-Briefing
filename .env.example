# Variable names only. Copy to .env and paste real values there. Never commit .env.
# In production (Trigger.dev) set the same four as Secrets in the dashboard: Environment Variables.

# Anthropic API key (console.anthropic.com). Pay-per-use, separate from the Claude subscription.
ANTHROPIC_API_KEY=

# Firecrawl API key (firecrawl.dev). Starts with fc-. Free plan: 1,000 credits a month.
FIRECRAWL_API_KEY=

# Google service account JSON key, base64-encoded on ONE line.
# PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
GOOGLE_SERVICE_ACCOUNT_B64=

# ID of the Google Sheet (the long part of its URL between /d/ and /edit).
# The sheet must be shared with the service account's email as Editor.
GOOGLE_SHEET_ID=
